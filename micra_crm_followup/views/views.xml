<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>

        <!-- Search View for CRM Followup Activities -->
        <record id="view_crm_followup_activity_search" model="ir.ui.view">
            <field name="name">mail.activity.search.crm.followup</field>
            <field name="model">mail.activity</field>
            <field name="arch" type="xml">
                <search string="Search Followup Activities">
                    <field name="res_name" string="Lead / Opportunity"/>
                    <field name="lead_id" string="Lead"/>
                    <field name="partner_id" string="Customer"/>
                    <field name="summary" string="Summary"/>
                    <field name="activity_type_id" string="Activity Type"/>
                    <field name="user_id" string="Assigned to"/>
                    <field name="phone" string="Phone"/>
                    <field name="email_from" string="Email"/>
                    <field name="stage_id" string="Stage"/>

                    <separator/>
                    <filter string="My Activities" name="my_activities" domain="[('user_id', '=', uid)]"/>
                    <separator/>
                    <filter string="Today &amp; Overdue" name="today_overdue" domain="[('date_deadline', '&lt;=', 'today')]"/>
                    <filter string="Overdue" name="overdue" domain="[('date_deadline', '&lt;', 'today')]"/>
                    <filter string="Today" name="today" domain="[('date_deadline', '=', 'today')]"/>
                    <filter string="Future / Planned" name="future" domain="[('date_deadline', '&gt;', 'today')]"/>
                    <separator/>
                    <filter string="Archived / Done" name="inactive" domain="[('active', '=', False)]"/>

                    <group>
                        <filter string="Assigned To" name="group_by_user" context="{'group_by': 'user_id'}"/>
                        <filter string="Activity Type" name="group_by_activity_type" context="{'group_by': 'activity_type_id'}"/>
                        <filter string="Due Date" name="group_by_deadline" context="{'group_by': 'date_deadline'}"/>
                        <filter string="Lead / Opportunity" name="group_by_lead" context="{'group_by': 'lead_id'}"/>
                        <filter string="Stage" name="group_by_stage" context="{'group_by': 'stage_id'}"/>
                        <filter string="Customer" name="group_by_partner" context="{'group_by': 'partner_id'}"/>
                    </group>
                </search>
            </field>
        </record>

        <!-- List View for CRM Followup Activities -->
        <record id="view_crm_followup_activity_tree" model="ir.ui.view">
            <field name="name">mail.activity.list.crm.followup</field>
            <field name="model">mail.activity</field>
            <field name="arch" type="xml">
                <list string="Followup Activities" sample="1" decoration-danger="state == 'overdue'" decoration-warning="state == 'today'" decoration-success="state == 'planned'">
                    <field name="date_deadline"/>
                    <field name="state" widget="badge" decoration-danger="state == 'overdue'" decoration-warning="state == 'today'" decoration-success="state == 'planned'"/>
                    <field name="lead_id" string="Lead / Opportunity"/>
                    <field name="partner_id" string="Customer"/>
                    <field name="phone" optional="show"/>
                    <field name="email_from" optional="hide"/>
                    <field name="activity_type_id" string="Activity Type"/>
                    <field name="note" string="note"/>
                    <field name="user_id" widget="many2one_avatar_user" string="Assigned To"/>
                    <field name="stage_id" optional="show" widget="badge"/>
                    <field name="expected_revenue" optional="show" widget="monetary" options="{'currency_field': 'company_currency'}"/>
                    <field name="company_currency" column_invisible="True"/>
                    <button name="action_done" type="object" string="Done" icon="fa-check" class="btn-success"/>
                    <button name="action_done_schedule_next" type="object" string="Schedule Next" icon="fa-calendar" class="btn-secondary"/>
                    <button name="action_open_document" type="object" string="Open Lead" icon="fa-external-link" class="btn-link"/>
                </list>
            </field>
        </record>

        <!-- Kanban View for CRM Followup Activities -->
        <record id="view_crm_followup_activity_kanban" model="ir.ui.view">
            <field name="name">mail.activity.kanban.crm.followup</field>
            <field name="model">mail.activity</field>
            <field name="arch" type="xml">
                <kanban default_group_by="activity_type_id" sample="1" class="o_kanban_small_column">
                    <field name="date_deadline"/>
                    <field name="state"/>
                    <field name="activity_type_id"/>
                    <field name="note"/>
                    <field name="lead_id"/>
                    <field name="partner_id"/>
                    <field name="user_id"/>
                    <field name="icon"/>
                    <templates>
                        <t t-name="card">
                            <div class="d-flex justify-content-between align-items-center">
                                <span class="fw-bold fs-6">
                                    <i t-if="record.icon.raw_value" t-att-class="'fa ' + record.icon.raw_value + ' me-1'"/>
                                    <field name="activity_type_id"/>
                                </span>
                                <field name="state" widget="badge" decoration-danger="state == 'overdue'" decoration-warning="state == 'today'" decoration-success="state == 'planned'"/>
                            </div>
                            <div class="mt-1">
                                <strong><field name="note"/></strong>
                            </div>
                            <div class="text-muted mt-1" t-if="record.lead_id.raw_value">
                                <i class="fa fa-handshake-o me-1"/> <field name="lead_id"/>
                            </div>
                            <div class="text-muted" t-if="record.partner_id.raw_value">
                                <i class="fa fa-user me-1"/> <field name="partner_id"/>
                            </div>
                            <div class="text-muted" t-if="record.date_deadline.raw_value">
                                <i class="fa fa-clock-o me-1"/> <field name="date_deadline"/>
                            </div>
                            <footer class="pt-1 mt-2 d-flex justify-content-between align-items-center">
                                <div class="btn-group">
                                    <button name="action_done" type="object" string="Done" class="btn btn-sm btn-outline-success me-1">Done</button>
                                    <button name="action_open_document" type="object" string="Open" class="btn btn-sm btn-outline-primary">Open</button>
                                </div>
                                <field name="user_id" widget="many2one_avatar_user"/>
                            </footer>
                        </t>
                    </templates>
                </kanban>
            </field>
        </record>

        <!-- Window Action for CRM Followup Activities -->
        <record id="action_crm_followup_activity" model="ir.actions.act_window">
            <field name="name">Followup</field>
            <field name="res_model">mail.activity</field>
            <field name="view_mode">list,kanban,calendar,form</field>
            <field name="domain">[('res_model', '=', 'crm.lead')]</field>
            <field name="search_view_id" ref="view_crm_followup_activity_search"/>
            <field name="context">{
                'search_default_my_activities': 1,
                'search_default_today_overdue': 1,
                'default_res_model': 'crm.lead',
            }</field>
            <field name="help" type="html">
                <p class="o_view_nocontent_smiling_face">
                    No scheduled followup activities found!
                </p>
                <p>
                    Here you will see all activities scheduled for CRM leads (Today &amp; Overdue).
                </p>
            </field>
        </record>

        <!-- Action View References -->
        <record id="action_crm_followup_activity_view_tree" model="ir.actions.act_window.view">
            <field name="sequence" eval="1"/>
            <field name="view_mode">list</field>
            <field name="view_id" ref="view_crm_followup_activity_tree"/>
            <field name="act_window_id" ref="action_crm_followup_activity"/>
        </record>

        <record id="action_crm_followup_activity_view_kanban" model="ir.actions.act_window.view">
            <field name="sequence" eval="2"/>
            <field name="view_mode">kanban</field>
            <field name="view_id" ref="view_crm_followup_activity_kanban"/>
            <field name="act_window_id" ref="action_crm_followup_activity"/>
        </record>

        <!-- Top Menu Item: Followup in CRM (between Sales and Reporting) -->
        <menuitem
            id="menu_crm_followup"
            name="Followup"
            parent="crm.crm_menu_root"
            action="action_crm_followup_activity"
            sequence="10"
            groups="sales_team.group_sale_salesman"/>

    </data>
</odoo>
